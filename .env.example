# Accident Scrubber — environment
# On the VAST workshop VM the VSS + GPU variables are ALREADY exported from /config/<team>.config.
# You only need to add the keys marked "ADD".  Never commit a filled-in copy.

# ---- VSS backend (already set on the VM: INGRESS_URL / USERNAME / PASSWORD) ----
# VSS_URL=            # falls back to INGRESS_URL
# VSS_USERNAME=       # falls back to USERNAME
# VSS_PASSWORD=       # falls back to PASSWORD

# ---- GPU endpoints (already set on the VM) ----
# COSMOS3_REASON_URL=
# COSMOS3_REASON_MODEL=nvidia/cosmos3-reason
# GPU_BEARER_TOKEN=
# YOLO_URL=

# ---- Voice agent: ElevenLabs Agents (ADD) ----
ELEVENLABS_API_KEY=
# Printed by `npm run agent:setup` (creates/updates the agent + its client tools)
ELEVENLABS_AGENT_ID=
# Used only by agent:setup
ELEVENLABS_LLM=gemini-2.5-flash
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# webrtc (default, lowest latency) or websocket (fallback on locked-down networks)
NEXT_PUBLIC_VOICE_TRANSPORT=webrtc

# ---- Video editing: fal.ai (ADD) ----
FAL_KEY=
# google/gemini-omni-flash/v1.1/edit (default) · fal-ai/kling-video/o1/video-to-video/edit · any {prompt, video_url} edit endpoint
FAL_EDIT_MODEL=google/gemini-omni-flash/v1.1/edit
FAL_EDIT_RESOLUTION=720p
# Optional extra JSON merged into the fal input, e.g. {"seed": 7}
# FAL_EDIT_EXTRA_JSON=

# ---- Edit-prompt polishing: W&B Inference (already set on the VM; optional) ----
# WANDB_API_KEY=
# WANDB_TEAM=
# WANDB_PROJECT=
WANDB_MODEL=openai/gpt-oss-120b

# ---- Hosting behind the VSS ingress at /app (only for the k8s deploy) ----
# NEXT_PUBLIC_BASE_PATH=/app
