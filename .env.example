# Hailmary — environment
# On the VAST workshop VM the VSS + GPU settings are read automatically from /config
# (<team>.config and <team>-vss2-secret.yaml). Anything set here overrides them.
# You only need to add the keys marked "ADD".  Never commit a filled-in copy.

# ---- VSS backend (from the VM: INGRESS_URL / USERNAME / PASSWORD) ----
# VSS_URL=            # falls back to INGRESS_URL
# VSS_USERNAME=       # falls back to USERNAME
# VSS_PASSWORD=       # falls back to PASSWORD

# ---- GPU endpoints (from the VM's vss2 secret: cosmos_host/port/model, yolo_infer_host/port) ----
# COSMOS3_REASON_URL=
# Unset → the VM's cosmos_model, else whatever the endpoint serves (/v1/models)
# COSMOS3_REASON_MODEL=
# GPU_BEARER_TOKEN=
# YOLO_URL=

# ---- Voice agent: ElevenLabs Agents (ADD) ----
ELEVENLABS_API_KEY=
# Written here by `npm run agent:setup` (creates/updates the agent + its client tools)
ELEVENLABS_AGENT_ID=
# Used only by agent:setup. Any id from ElevenLabs' prompt.llm enum, e.g.
# qwen35-397b-a17b (ElevenLabs' default, hosted by ElevenLabs) · gemini-3.8-flash · claude-sonnet-5-5
ELEVENLABS_LLM=qwen35-397b-a17b
# Empty = model default. Otherwise none | minimal | low | medium | high (whatever the LLM supports)
ELEVENLABS_REASONING_EFFORT=
# eleven_v4_turbo (default, ~100ms, expressive) · eleven_flash_v2 (~75ms, plainer delivery)
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# webrtc (default, lowest latency) or websocket (fallback on locked-down networks)
NEXT_PUBLIC_VOICE_TRANSPORT=webrtc

# ---- Video editing: fal.ai (ADD) ----
# FAL_AI_API_KEY is accepted as an alias
FAL_KEY=
# minimax/h3/reference-to-video (default, ~20 s) · google/gemini-omni-flash/v1.1/edit (more faithful, ~75 s) · any {prompt, video_url} edit endpoint
FAL_EDIT_MODEL=minimax/h3/reference-to-video
# MiniMax: 480P (~2x faster) or 768P · Gemini Omni: 360p / 720p / 1080p / 4k
FAL_EDIT_RESOLUTION=768P
# Optional extra JSON merged into the fal input, e.g. {"seed": 7}
# FAL_EDIT_EXTRA_JSON=

# ---- Edit-prompt polishing: W&B Inference (already set on the VM; optional) ----
# WANDB_API_KEY=
# WANDB_TEAM=
# WANDB_PROJECT=
WANDB_MODEL=openai/gpt-oss-120b

# ---- Hosting behind the VSS ingress at /app (only for the k8s deploy) ----
# NEXT_PUBLIC_BASE_PATH=/app
# Public origin, read at build time, so link previews get absolute image URLs, e.g. https://hailmary.example.com
# SITE_URL=
