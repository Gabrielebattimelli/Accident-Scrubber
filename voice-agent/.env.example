# Sightline voice agent. Copy to voice-agent/.env (or reuse the repo-root .env).
# On the VAST workshop VM the VSS variables are already loaded from /config/<team>.config.

# ---- VSS backend ----
# VSS_URL=            # falls back to INGRESS_URL
# VSS_USERNAME=       # falls back to USERNAME
# VSS_PASSWORD=       # falls back to PASSWORD

# ---- Speech in + out (required) ----
ELEVENLABS_API_KEY=
# SIGHTLINE_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # default: "Sarah"

# ---- Agent LLM: OpenAI if this key works, otherwise W&B Inference (gpt-oss-120b) ----
OPENAI_API_KEY=
# WANDB_API_KEY=
# WANDB_TEAM=
# WANDB_PROJECT=

# ---- Scrub (generative video edit on fal) ----
FAL_KEY=                # falls back to FAL_AI_API_KEY
# FAL_EDIT_MODEL=minimax/h3/reference-to-video   # or google/gemini-omni-flash/v1.1/edit (slower, more faithful)
# FAL_EDIT_RESOLUTION=768P                       # MiniMax only: 480P is ~2x faster

# ---- Cosmos3-Reason grounding for forklift / robot boxes (optional) ----
# COSMOS3_REASON_URL=http://<gpu-host>:8001
# GPU_BEARER_TOKEN=
